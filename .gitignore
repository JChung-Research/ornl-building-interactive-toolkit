# ============================================================
#  ORBIT — repository ignore rules
#  NOTE: secrets and large binaries must NEVER be committed.
# ============================================================

# ---- Secrets / credentials (NEVER commit) ----
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
**/certs/
secrets/

# VOLTTRON platform identity — runtime-generated keypair; the keystore holds a private key.
# Regenerated per deployment; must never be published.
middleware/middleware_config/keystore

# Site-specific configs — generated per deployment; only the folder READMEs are tracked.
middleware/agent_config/*
!middleware/agent_config/README.md
web-app/configs/*
!web-app/configs/README.md

# ---- Node / TypeScript ----
node_modules/
.next/
build/
dist/
out/
coverage/
*.tsbuildinfo
.yarn/
.pnp.*
.cache/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Logs ----
*.log

# ---- Build artifacts / archives ----
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# ---- Runtime / service data ----
**/influxdb-data/
**/postgres-data/
**/pgdata/

# ---- License files ----
*.lic

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/

context-license/
extra/

# ---- Large datasets & generated binaries (regenerable; too big for git/GitHub) ----
# Prisma query/schema engine binaries (regenerated by `prisma generate`)
**/lib/*-openssl-*/
# BOPTEST simulation datasets — small config/room_mapping*.csv are kept
**/boptest-coordinator/boptest_*.csv
# InfluxDB historian exports / dumps
**/influxdb_historian/influx_export/
# JS build source maps
**/public/static/**/*.map